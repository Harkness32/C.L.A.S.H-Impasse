class CfgRemoteExec {
    // List of Functions allowed to be sent from client via remoteExec
    class Functions {
        mode = 2;           // 2: Allow All
        jip = 1;            // 1: JIP Allowed
        allowedTargets = 0; // 0: All machines
    };
    // List of Commands allowed to be sent from client via remoteExec
    class Commands {
        mode = 2;           // 2: Allow All
        jip = 1;            // 1: JIP Allowed
        allowedTargets = 0; // 0: All machines
    };
};

