*.md text eol=lf
*.json text eol=lf
*.py text eol=lf

# Preserve Arma source bytes. Git line-ending conversion can create false
# parity failures or silently change a mission build.
*.sqf -text
*.sqm -text
*.ext -text
*.hpp -text
*.cpp -text
*.rvmat -text

# Vendored NR6 HAL. Upstream's bytes, line endings included: the mission never
# edits this tree, it is patched at runtime instead, and the *.md rule above
# was renormalising license.md into a permanent phantom diff that showed up as
# uncommitted work every turn and once blocked a stash pop mid-task.
"NR6 Hal/**" -text
